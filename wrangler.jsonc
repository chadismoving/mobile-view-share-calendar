{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mobile-share-calendar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": { "ENVIRONMENT": "production" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mobile-share-calendar",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "READ_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "env": {
    "development": {
      "name": "mobile-share-calendar-local",
      "ratelimits": [
        {
          "name": "READ_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 1000, "period": 60 }
        },
        {
          "name": "CREATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 1000, "period": 60 }
        }
      ],
      "vars": { "ENVIRONMENT": "development" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mobile-share-calendar-local",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
