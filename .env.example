# Local development uses the explicit development environment in wrangler.jsonc.
# Production configuration: supply these in your shell or GitHub repository variables.
D1_DATABASE_ID=replace-with-production-database-uuid
EDITOR_ORIGIN=https://cl-edit.d.htd.ink
PUBLIC_SHARE_ORIGIN=https://cl.d.htd.ink
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-audience
# Set CLOUDFLARE_API_TOKEN as a GitHub Actions production environment secret.
# Set CLOUDFLARE_ACCOUNT_ID as a GitHub Actions repository variable.
# Optional Google Maps integration. Browser key must be restricted to the editor,
# public share origin, and localhost during development; enable Maps JavaScript
# API and Geocoding API in the Google project. Supply via .dev.vars locally and
# the production Environment GOOGLE_MAPS_BROWSER_KEY secret on GitHub.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
