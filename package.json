{
  "name": "mobile-share-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --env development",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run build:worker",
    "build:worker": "wrangler deploy --env \"\" --dry-run --outdir .worker-build",
    "db:local": "wrangler d1 migrations apply DB --local --env development",
    "deploy": "npm run build && node scripts/production-config.mjs && wrangler deploy --config .wrangler.production.json",
    "db:production": "node scripts/d1-config.mjs && wrangler d1 migrations apply DB --remote --config .wrangler.d1.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource-variable/noto-serif-tc": "^5.3.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.15",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
